# ─── 공공데이터 API 인증키 ───────────────────────────────────────────────
# 공공데이터포털(data.go.kr)에서 발급받은 서비스키를 사용합니다.
# HIRA(건강보험심사평가원) 병원정보서비스 서비스키
HIRA_SERVICE_KEY=

# 법제처 국가법령정보 공동활용 OpenAPI 이용자 이메일 ID (오픈API 신청 시 등록한 ID)
LAW_API_OC=

# ─── Local SLM (GGUF) ────────────────────────────────────────────────────
# 기본적으로는 앱 안에서(사이드바 "로컬 SLM" 패널) .gguf 모델 파일을 직접
# 선택하면 되고, 이 환경변수들은 필요 없습니다. node-llama-cpp가 프로세스
# 안에서 바로 모델을 구동합니다.
#
# 아래는 GGUF 모델을 로드하지 않았을 때(또는 별도의 llama.cpp 서버를 직접
# 운영하고 싶을 때)만 쓰는 고급 옵션입니다. llama.cpp를 `llama-server`
# 모드로 띄운 뒤 해당 엔드포인트를 지정하세요.
# 예: llama-server -m model.gguf --port 8080
LLAMA_SERVER_URL=http://127.0.0.1:8080
# GGUF 모델도, llama.cpp 서버도 없으면 규칙 기반 폴백으로 자동 전환됩니다
# (core/llm/inference/ruleBasedFallback.ts).

# ─── 로컬 저장소 ─────────────────────────────────────────────────────────
# 대화/캐시 SQLite 파일 경로 (Electron 실행 시 userData 경로로 자동 대체됨)
APP_DB_PATH=./data/runtime/app.sqlite3
